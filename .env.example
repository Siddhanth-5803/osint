# Copy this file to .env and fill it in. Never commit .env or share your keys.

# --- Claude (required for the AI roast) ---
# Get a key at https://console.anthropic.com -> API Keys. Add a few dollars of credit.
ANTHROPIC_API_KEY=

# Investigation depths visitors can pick (each uses a different Claude model):
#   quick    = Quick Peek      -> claude-haiku-5-5   under ₹1 per raid
#   standard = Stakeout        -> claude-sonnet-5-5  about ₹13 per raid
#   deep     = Full Forensics  -> claude-opus-5-5    about ₹25 per raid
ALLOWED_DEPTHS=quick,standard,deep
# low | medium | high  (higher = more careful, slower, a bit more expensive)
CLAUDE_EFFORT=medium

# --- Access and payments ---
# free       = anyone can run the roast, FREE_DAILY_LIMIT per person per day. Promo codes are unlimited.
# promo_only = only people with a promo code can run the roast.
# paid       = PRICE_INR per roast through Razorpay. Promo codes still free.
ACCESS_MODE=free
PRICE_INR=5
FREE_DAILY_LIMIT=5

# Extra promo codes, comma separated (the built-in code always works).
PROMO_CODES=

# --- Razorpay (only needed when ACCESS_MODE=paid) ---
# Dashboard -> Account & Settings -> API Keys. Use the test keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# The most characters of chat one investigation can read when "Everything" is picked.
# 600000 is roughly 200,000 tokens. Raise it to read bigger chats in full (each raid then costs more).
MAX_READ_CHARS=600000

# Port for local running.
PORT=3000

# Testing only: 1 = fake roast, no AI call, no cost.
MOCK_AI=0
# Testing only: path to a saved case-file JSON to show instead of calling Claude.
MOCK_AI_FILE=
