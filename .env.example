# Copy this file to .env and fill it in. Never commit .env or share your keys.

# --- Claude (required for the AI roast) ---
# Get a key at https://console.anthropic.com -> API Keys. Add a few dollars of credit.
ANTHROPIC_API_KEY=

# Which Claude model writes the roast. Default is the best quality.
#   claude-opus-5-5    best writing, about ₹25 per raid
#   claude-sonnet-5-5  very good, about ₹13 per raid
#   claude-haiku-5-5   good and very cheap, under ₹1 per raid
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high  (higher = more careful, slower, a bit more expensive)
CLAUDE_EFFORT=medium

# --- Access and payments ---
# free       = anyone can run the roast, FREE_DAILY_LIMIT per person per day. Promo codes are unlimited.
# promo_only = only people with a promo code can run the roast.
# paid       = PRICE_INR per roast through Razorpay. Promo codes still free.
ACCESS_MODE=free
PRICE_INR=5
FREE_DAILY_LIMIT=5

# Extra promo codes, comma separated (the built-in code always works).
PROMO_CODES=

# --- Razorpay (only needed when ACCESS_MODE=paid) ---
# Dashboard -> Account & Settings -> API Keys. Use the test keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Port for local running.
PORT=3000

# Testing only: 1 = fake roast, no AI call, no cost.
MOCK_AI=0
